{"columns":["rowid","id","room_id","sender_user_id","is_twin","kind","text","photo_id","utterance_id","conversation_id","question_log_id","client_key","sent_at"],"rows":[[8578,5235751031416932,2615179707560968,1,0,"発言","あけましておめでとうございます。",null,null,null,null,"script-80ae8c192b9c39fb-8644","2036-01-01T08:10:00.005242+09:00"],[8579,3830099745161407,2615179707560968,5,0,"発言","あけましておめでとうございます 今年もよろしくお願いします",null,null,null,null,"script-7e326359fde768b3-8645","2036-01-01T09:20:00.006841+09:00"],[8580,1450487503043211,8985664698379372,4,0,"発言","着いたばい。あけましておめでとう。餅ば持って来た。去年の正月も西鉄の話が止まらんかった。今年もそれでよか。",null,null,null,null,"script-813591b2780a0091-8646","2036-01-01T12:56:00.011939+09:00"],[8581,8322627312826581,1165208662864940,4,0,"発言",null,null,7671729453925632,8670863050762879,null,"script-ebe8a8e15da18950-8647","2036-01-01T17:20:00.006242+09:00"],[8582,7057727240048391,1165208662864940,3,0,"発言",null,null,6983955200691696,8670863050762879,null,"script-7e5dcbcc56cc97d3-8648","2036-01-01T17:40:00.005896+09:00"],[8583,1160472081576992,762065606528927,3,0,"発言","いま電車に乗ったよ。健太と夫も一緒。昼前に着く。",null,null,null,null,"script-a6f45b2976667d49-8649","2036-01-02T09:40:00.005415+09:00"],[8584,2557331563220957,762065606528927,1,0,"発言","了解。待っとる。",null,null,null,null,"script-a71de6a5d31a89ec-8650","2036-01-02T09:50:00.005186+09:00"],[8585,2950971359027852,1165208662864940,6900329751302857,0,"発言",null,4382131914183118,3093224826409851,8670863050762879,null,"script-502f8333031e2798-8651","2036-01-02T14:40:00.040988+09:00"],[8586,4311679886772795,1165208662864940,3,0,"発言",null,null,4274396796397861,8670863050762879,null,"script-0a6a157f2d2149b8-8652","2036-01-02T15:10:00.005544+09:00"],[8587,5169999327988325,4887126960195401,1171315306058308,0,"発言","鈴木さん、正月から寄らせてもらいました。154の90です。お孫さんも一緒で賑やかですね。",null,null,null,null,"script-5b2919494690b586-8653","2036-01-03T11:00:00.008295+09:00"],[8588,5367103343253027,4887126960195401,1,0,"発言","先生。正月。",null,null,null,null,"script-9bc9b1e4c94fdf76-8654","2036-01-03T11:08:00.005762+09:00"],[8589,2275532250225709,4035355693922802,1,0,"発言",null,null,1351833362321579,6867929263912269,null,"script-a89f372371c79d8c-8655","2036-01-03T14:10:00.009462+09:00"],[8590,6512431824303574,4035355693922802,null,1,"発言",null,null,5248169474872519,6867929263912269,null,null,"2036-01-03T14:10:00.009462+09:00"],[8591,2801653320231379,762065606528927,3,0,"発言","着いたよ。二日間ありがとう。",null,null,null,null,"script-552816216b3f72ab-8657","2036-01-03T17:30:00.008272+09:00"],[8592,8513135429958537,762065606528927,1,0,"発言","健太は。",null,null,null,null,"script-9e0e457f1b2b0eca-8658","2036-01-03T19:35:00.005611+09:00"],[8593,601797155522778,762065606528927,3,0,"発言","元気よ。車で寝とる。お父さんも早く寝てね。",null,null,null,null,"script-148b0211ee9599e3-8659","2036-01-03T19:40:00.005661+09:00"],[8594,5700697448659306,5727177846694779,3,0,"発言","先生、今年は玄関で健太の名前がすぐ出ました。去年と逆でした。ただ、夕方に一度だけ「和子はまだか」と言いました。どう答えればよかったのでしょう。",null,null,null,null,"script-4ea6052d37e4df34-8661","2036-01-03T21:40:00.007437+09:00"],[8595,8614603524280646,5727177846694779,1171315306058308,0,"発言","「お母さんは今夜は遅くなるって」と答えた去年のやり方で、今は構いません。嘘ではなく、夜を越えるための言葉です。ただ、毎回それでは美穂さんが疲れます。夕方五時に誰かがそばにいる形を、田中君と一緒に考えましょう。",null,null,null,null,"script-1ee253450b1b7710-8662","2036-01-03T22:05:00.009535+09:00"],[8596,7673343908247880,4035355693922802,1,0,"発言",null,null,7602130553983986,6867929263912269,null,"script-d423504648d97362-8663","2036-01-03T23:30:00.006301+09:00"],[8597,329159118575613,4035355693922802,null,1,"発言",null,null,2196578436119585,6867929263912269,null,null,"2036-01-03T23:30:00.006301+09:00"],[8598,891075729709869,4035355693922802,1,0,"発言",null,null,5211579120685180,6867929263912269,null,"script-ef1fb7958703dbaf-8664","2036-01-03T23:50:00.011834+09:00"],[8599,3601196329376402,4035355693922802,null,1,"発言",null,null,3683935599867662,6867929263912269,null,null,"2036-01-03T23:50:00.011834+09:00"],[8600,7830461285038629,4035355693922802,null,1,"発言",null,null,6119011398464111,6867929263912269,null,null,"2036-01-03T23:50:01.007565+09:00"],[8602,6109776704309069,4035355693922802,1,0,"発言",null,null,7127254770873928,5464516684849004,null,"script-cd26f53fc78b8861-8667","2036-01-04T12:30:00.006531+09:00"],[8603,3707088574461807,4035355693922802,null,1,"発言",null,null,2714149444971497,5464516684849004,null,null,"2036-01-04T12:30:00.006531+09:00"],[8604,3117455650401076,4035355693922802,null,1,"発言",null,null,4818020006202774,5464516684849004,null,null,"2036-01-04T12:30:02.006627+09:00"],[8605,56777160031400,4035355693922802,null,1,"発言",null,null,2283196405812068,5464516684849004,null,null,"2036-01-04T12:30:02.006627+09:00"],[8606,3855830908605799,8985664698379372,4,0,"発言","着いたばい。小寒ち言うが、縁側は晴れよる。美穂ちゃんもおるな。",null,null,null,null,"script-e07232298ad1216a-8670","2036-01-05T12:55:00.007472+09:00"],[8607,3063890141483616,1165208662864940,3,0,"発言",null,null,7082369246213715,8670863050762879,null,"script-6449d40791eefeae-8671","2036-01-05T21:50:00.014534+09:00"],[8608,2505216401499730,762065606528927,3,0,"発言","バス停に着いたよ。二日間ありがとう。ストーブ、見てね。",null,null,null,null,"script-add99cf117e6593e-8672","2036-01-06T17:30:00.004866+09:00"],[8609,1432942310826291,762065606528927,1,0,"発言","気をつけて。",null,null,null,null,"script-b4cea6f65382a7c9-8673","2036-01-06T17:50:00.006691+09:00"],[8610,8303678538007233,8985664698379372,4,0,"発言","着いたばい。晴れて縁側がぬくか。",null,null,null,null,"script-be83741218a045ce-8675","2036-01-12T12:56:00.007002+09:00"],[8611,8810234201087400,1165208662864940,4,0,"発言",null,null,3244439138880657,8670863050762879,null,"script-24a1e6fa8b9cefa4-8676","2036-01-12T17:10:00.006178+09:00"],[8612,8532759518400109,4035355693922802,1,0,"発言",null,null,8003889591826382,3664963251048041,null,"script-f414f29407be9fe6-8677","2036-01-14T08:20:00.007599+09:00"],[8613,437660807469649,4035355693922802,null,1,"発言",null,null,2428022953965192,3664963251048041,null,null,"2036-01-14T08:20:00.007599+09:00"],[8614,5389027368956423,4035355693922802,null,1,"発言",null,null,2439016633188880,3664963251048041,null,null,"2036-01-14T08:20:02.006303+09:00"],[8615,1180751986654862,4035355693922802,null,1,"発言",null,null,7198204904784697,3664963251048041,null,null,"2036-01-14T08:20:02.006303+09:00"],[8616,8413510339626484,8985664698379372,4,0,"発言","着いたばい。今日は水仙がよう匂うな。",null,null,null,null,"script-2fe31d37d2e06d1f-8681","2036-01-15T12:57:00.016899+09:00"],[8617,6816660334257887,1165208662864940,4,0,"発言",null,null,3654314623547918,8670863050762879,null,"script-533ea8a956658b01-8682","2036-01-15T17:20:00.016299+09:00"],[8618,3825687278660247,4887126960195401,1171315306058308,0,"発言","鈴木さん、寄らせてもらいました。159の86でした。足は冷えていませんか。",null,null,null,null,"script-0c27af5142b888b3-8683","2036-01-17T11:00:00.005499+09:00"],[8619,402703627664168,4887126960195401,1,0,"発言","冷たか。",null,null,null,null,"script-12d09e54a189e156-8684","2036-01-17T11:09:00.034641+09:00"],[8620,8338456442205250,5727177846694779,1171315306058308,0,"発言","159の86。体重は横ばいです。あした田中君が、正式に担当になります。お父様の前には、すぐには立たせません。まず記録を読ませてください。",null,null,null,null,"script-d3107e84d3a2026e-8685","2036-01-17T11:30:00.024503+09:00"],[8621,2939331998056965,5727177846694779,3,0,"発言","お願いします。今夜、田中さんを招待します。",null,null,null,null,"script-72f519f8f189ea94-8686","2036-01-17T11:50:00.016736+09:00"],[8622,6123139780949655,6367279538259149,7457996563753134,0,"発言","美穂さん、田中と申します。昨日、井ノ口先生からご紹介をいただき、お父様の担当を引き受けました。招待のメッセージ、ありがとうございます。今、このアプリの入口に立っています。",null,null,null,null,"script-80132fe475904cb4-8689","2036-01-18T12:05:02.023532+09:00"],[8623,6782761622258992,6367279538259149,3,0,"発言","田中さん、よろしくお願いします。以前のケアマネさんが予告なしに日曜に来られて、父が怒鳴って追い返しました。父は他人が家に来るのを、本当に嫌がります。",null,null,null,null,"script-741043b7dce31623-8690","2036-01-18T12:25:00.060816+09:00"],[8624,6084578132083943,6367279538259149,7457996563753134,0,"発言","伺っています。お一人でずっと抱え込まれて、本当によく頑張ってこられましたね。まずはお疲れさまでした。お父様の前に私が立つのは、急ぎません。美穂さんを通して、お父様が「よか」と言える形を整えてから伺います。日曜に突然、は二度といたしません。まずは記録を読み、お父様の言葉を知るところから始めさせてください。",null,null,null,null,"script-faa8205cfb2cc4af-8691","2036-01-18T12:48:00.059801+09:00"],[8625,806643165578478,1724362114962653,7457996563753134,0,"発言","チームを作りました。美穂さん、井ノ口先生、私の三人です。お父様のいない部屋ですので、心配なことは正直に書いてください。ただ、何かを決める前には、必ずお父様の言葉に戻りましょう。",null,null,null,null,"script-f704e335f7e8b9d5-8693","2036-01-18T18:00:01.037185+09:00"],[8626,7029499246054201,1724362114962653,1171315306058308,0,"発言","田中君、よろしく頼む。一つだけ。家に入る人を、いっぺんに増やさんこと。",null,null,null,null,"script-a6fc646c8956b19c-8694","2036-01-18T18:20:00.035068+09:00"],[8627,1800708205535492,1724362114962653,3,0,"発言","よろしくお願いします。施設の見学の空きが、三月ごろに出ると聞いています。決めるためではなく、知っておくためのつもりですが、わたしの中ではまだ揺れています。",null,null,null,null,"script-875aa6906e40db5b-8695","2036-01-18T18:35:00.019760+09:00"],[8628,7650664166745751,1724362114962653,7457996563753134,0,"発言","揺れていて当然です。空きの連絡が来たら、期限を一緒に確認しましょう。美穂さんが一人で決める必要はありません。",null,null,null,null,"script-054f7a1e94534761-8696","2036-01-18T18:50:00.033264+09:00"],[8629,2547473162988373,5084375815500449,7457996563753134,0,"発言","正雄さん、はじめまして。誠一さんのケアマネジャーになりました田中と申します。火曜と土曜に誠一さんのお宅へ通ってくださっていると伺いました。まず、お礼を申し上げます。",null,null,null,null,"script-f98fb4f4ec9109c6-8698","2036-01-19T10:30:01.044384+09:00"],[8630,2088035445705970,5084375815500449,4,0,"発言","田中さんか。話は美穂ちゃんから聞いとる。誠さんは他人が家に入るのを好かんばい。あんた、将棋は指すか。",null,null,null,null,"script-088939915b540ea1-8699","2036-01-19T11:10:00.085429+09:00"],[8631,7676490765346588,5084375815500449,7457996563753134,0,"発言","指します。弱いですが、駒の動かし方は子どものころに祖父から教わりました。",null,null,null,null,"script-20ba1bd24430a084-8700","2036-01-19T11:25:00.050275+09:00"],[8632,5771597111371870,5084375815500449,4,0,"発言","弱かのは信用できる。強かもんは、誠さんの前で威張るけん好かん。四時半を過ぎると、誠さんは玄関の戸を見ては座り直す。俺は五時過ぎまでおる。そしたら、見らんごとなる。",null,null,null,null,"script-9b48bcd52ca7f51a-8701","2036-01-19T11:40:00.062377+09:00"],[8633,5456602992245062,5084375815500449,7457996563753134,0,"発言","教えてくださってありがとうございます。火曜と土曜の五時の玄関のことは、大事に覚えておきます。",null,null,null,null,"script-da7f9251a5c085eb-8702","2036-01-19T11:55:00.080008+09:00"],[8634,954771351475946,8985664698379372,4,0,"発言","着いたばい。雪まじりたいな。サッシは閉めとくぞ。",null,null,null,null,"script-c1de8e0f37d32b67-8703","2036-01-19T12:56:00.064056+09:00"],[8635,3885516876243970,1713317520869645,1,0,"お知らせ","ツイン（AI）がこの部屋に入りました。ここでの話を読みます。",null,null,null,null,null,"2036-01-20T11:30:01.077637+09:00"],[8636,3113258791976536,1713317520869645,3,0,"発言",null,null,3385648749163907,8369504108748565,null,"script-011865d9d461e652-8706","2036-01-20T11:30:02.044256+09:00"],[8637,3205180187100190,762065606528927,3,0,"発言","バス停に着いたよ。二日間ありがとう。",null,null,null,null,"script-21b87e67bc02d5f8-8707","2036-01-20T17:30:00.006773+09:00"],[8638,6962591890595114,6463063817483889,7457996563753134,0,"発言","先生、田中です。お時間のある時に、血圧の推移と体重の変わり方を教えてください。それと、お父様が受け入れやすい訪問の曜日と時間帯を、先生の感触で結構ですので。",null,null,null,null,"script-bd90caa4ee7918c5-8709","2036-01-22T18:20:01.006156+09:00"],[8639,4689026552202827,6463063817483889,1171315306058308,0,"発言","夕方より、昼過ぎがよかです。朝は機嫌が悪い。夕方は玄関を気にする。木曜の昼に私が寄る日に、お茶を一緒に、が一番通りやすかった。急がんでよかですよ。",null,null,null,null,"script-784fdcc654ec7d93-8710","2036-01-22T19:05:00.006552+09:00"],[8640,4012793833939829,4251523932161740,7457996563753134,0,"発言","節子さま、突然のご連絡をお許しください。鈴木誠一さんの担当ケアマネジャーになりました田中と申します。美穂さんから、朝夕の呼び鈴などで長くご負担をおかけしていると伺いました。まず、お詫びと、長年のお気遣いへの感謝をお伝えしたく存じます。",null,null,null,null,"script-e2456d229a82fa61-8712","2036-01-24T10:00:01.006080+09:00"],[8641,4511034427155405,4251523932161740,5,0,"発言","田中さま ご連絡ありがとうございます 助けていただけるのでしたら ありがたいです 呼び鈴だけがつらいです お返事はゆっくりで大丈夫です",null,null,null,null,"script-6fdaa2f27a5b0338-8713","2036-01-24T11:30:00.005210+09:00"],[8642,6020478044739526,4251523932161740,7457996563753134,0,"発言","ありがとうございます。呼び鈴を押さなくても済む仕組みを、必ず形にします。時間をいただきますが、節子さまがお一人で背負わなくてよい形を考えます。",null,null,null,null,"script-9335c7fa512cb090-8714","2036-01-24T11:50:00.007199+09:00"],[8643,6557075613131348,4035355693922802,1,0,"発言",null,null,5417425489680182,5784503451767686,null,"script-5b03539c2cb1de60-8715","2036-01-25T21:30:00.005832+09:00"],[8644,35828658671505,4035355693922802,null,1,"発言",null,null,4949399835719732,5784503451767686,null,null,"2036-01-25T21:30:00.005832+09:00"],[8645,1893083640495606,4035355693922802,null,1,"発言",null,null,2222816439324083,5784503451767686,null,null,"2036-01-25T21:30:02.006382+09:00"],[8646,6576745158161393,4035355693922802,null,1,"発言",null,null,845450271883090,5784503451767686,null,null,"2036-01-25T21:30:02.006382+09:00"],[8647,8661325887352385,8985664698379372,4,0,"発言","着いたばい。今日も晴れたな。",null,null,null,null,"script-c5ac5a7456024bd0-8718","2036-01-26T12:56:00.021438+09:00"],[8648,6933768815493696,1713317520869645,4,0,"発言",null,null,7086568164838695,8369504108748565,null,"script-025855288ee7a26a-8719","2036-01-26T17:10:00.015052+09:00"],[8649,6101889355901798,4887126960195401,1171315306058308,0,"発言","鈴木さん、154の88でした。今日のお茶は、少し薄めでした。ちょうどよかです。",null,null,null,null,"script-b7e19cb28cbfe2a5-8720","2036-01-31T11:00:00.005030+09:00"],[8650,1088422702242732,4887126960195401,1,0,"発言","薄め。",null,null,null,null,"script-b71b33759ce7d148-8721","2036-01-31T11:08:00.006029+09:00"],[8651,6479811248618109,4035355693922802,1,0,"発言",null,null,3766697217522487,8942958649196631,null,"script-077f391972c98dd1-8722","2036-02-01T17:50:00.007811+09:00"],[8652,6879151481787882,4035355693922802,null,1,"発言",null,null,2632673136607132,8942958649196631,null,null,"2036-02-01T17:50:00.007811+09:00"],[8653,1128493180256566,4035355693922802,null,1,"発言",null,null,3339891841781113,8942958649196631,null,null,"2036-02-01T17:50:02.005541+09:00"],[8654,6601726421915211,4035355693922802,null,1,"発言",null,null,7217884811208522,8942958649196631,null,null,"2036-02-01T17:50:02.005541+09:00"],[8655,7519157598489127,8985664698379372,4,0,"発言","着いたばい。美穂ちゃんもおるな。晴れて冷たか。",null,null,null,null,"script-9b73d74f27728791-8725","2036-02-02T12:56:00.016048+09:00"],[8656,7996320318697410,762065606528927,3,0,"発言","バス停に着いたよ。二日間ありがとう。節分の鬼は、帰ったね。",null,null,null,null,"script-e365712c57d83459-8726","2036-02-03T17:30:00.012894+09:00"],[8657,2159161253392500,762065606528927,1,0,"発言","鬼は外。",null,null,null,null,"script-77b2b5150311d349-8727","2036-02-03T17:50:00.012732+09:00"],[8658,5530388002457737,8985664698379372,4,0,"発言","着いたばい。雨たいな。土鍋の米は研いどくぞ。",null,null,null,null,"script-a2f2122e512c0567-8728","2036-02-05T12:58:00.013151+09:00"],[8659,4174454289615879,1713317520869645,4,0,"発言",null,3022173144218798,4335814780049700,8369504108748565,null,"script-0e6a8151c8b68896-8729","2036-02-05T17:20:00.043382+09:00"],[8660,6643898964214172,1713317520869645,3,0,"発言",null,null,4084785140901309,8369504108748565,null,"script-7d7fa22c117577e7-8730","2036-02-05T17:40:00.004647+09:00"],[8661,5267445377555180,8985664698379372,4,0,"発言","着いたばい。今日は美穂ちゃんがおらんな。茶ば熱かのをくれ。",null,null,null,null,"script-fe97657d54039cbd-8731","2036-02-09T12:57:00.004801+09:00"],[8662,909787670453294,1713317520869645,4,0,"発言",null,null,8065999375918276,8369504108748565,null,"script-dba509ef244e8390-8732","2036-02-09T17:15:00.005591+09:00"],[8663,7149678740258419,4035355693922802,1,0,"発言",null,null,8520422200831055,8023149338225273,null,"script-a1354ba8078225e8-8733","2036-02-10T12:40:00.004838+09:00"],[8664,7304229711080654,4035355693922802,null,1,"発言",null,null,6340283747524246,8023149338225273,null,null,"2036-02-10T12:40:00.004838+09:00"],[8665,6555327800930875,4035355693922802,null,1,"発言",null,null,5946589953596915,8023149338225273,null,null,"2036-02-10T12:40:02.006096+09:00"],[8666,4258959026482682,4035355693922802,null,1,"発言",null,null,7986912566048669,8023149338225273,null,null,"2036-02-10T12:40:02.006096+09:00"],[8667,7169491730772076,1724362114962653,7457996563753134,0,"発言","ツインに伺いながら、この三週間、毎晩少しずつ記録を読んできました。今日は、ここまでに分かったことを、お父様の言葉のまま書いておきます。私の解釈は、あとに回します。",null,null,null,null,"script-874ee38ad27a67a8-8736","2036-02-10T20:00:00.012970+09:00"],[8668,2649379092411,1724362114962653,7457996563753134,0,"発言","一つ目はご飯です。2026年10月11日のつぶやきに「冷や飯なんざ食えるか。飯は炊きたてが一番たい。」とあります。2030年2月10日には「飯ちゅうのは、蓋を開けた瞬間の湯気と匂いを食うもんたい。」。2029年10月17日には「肉は冷凍してもよかが、飯は冷凍したら飯じゃなくなる。」。冷凍も配食もだめな理由は、味だけではないようです。",null,null,null,null,"script-7aadaa05d880ff04-8737","2036-02-10T20:05:00.011631+09:00"],[8669,2951364715254915,1724362114962653,7457996563753134,0,"発言","2029年12月15日のツインへに、ご飯の決まりの始まりがありました。「おふくろは、俺が役所に入る朝、炊きたてを茶碗に盛って『あんたは冷や飯を食わんでよか人になりなさい』と言うた。あれが、俺の飯の決まりの始まりたい。」。2032年6月18日には、夜勤のお父上に弁当を懐に入れて走った記憶があり、「冷や飯を食わんのは、あの懐の温かさを覚えとるからかもしれん。」とあります。",null,null,null,null,"script-4de427353b50e0c0-8738","2036-02-10T20:12:00.004660+09:00"],[8670,191679948527817,1724362114962653,7457996563753134,0,"発言","2034年10月20日のつぶやきには「弁当のご飯は冷たかろう。冷たいところは、炊きたてで消す。」とあります。配食弁当は選べません。炊きたてを足す形、あるいは目の前で炊く形なら、受け入れていただける可能性があります。",null,null,null,null,"script-02f4a348a06f6589-8739","2036-02-10T20:20:00.013046+09:00"],[8671,2019212740900029,1724362114962653,3,0,"発言","炊飯器の紙の手順は、最後のボタンだけ、指をささないと押せない日があります。毎日誰かが隣にいないと無理です。",null,null,null,null,"script-35cad01ee7c37696-8740","2036-02-10T20:30:00.014316+09:00"],[8672,4536798719686646,1724362114962653,7457996563753134,0,"発言","はい。毎日は、美穂さんにも正雄さんにも無理です。だから、夕方に人が入って、一緒に炊く形を考えています。詳しくは、お父様の前でゆっくりお話しします。",null,null,null,null,"script-310bf57c4b18636e-8741","2036-02-10T20:40:00.011779+09:00"],[8673,4948501298843313,1724362114962653,7457996563753134,0,"発言","二つ目は風呂です。2026年10月18日のツインへに「一人で長風呂に入る時間だけは、誰にも邪魔されとうなか。」。2030年6月16日のつぶやきでは、町内の温泉旅行を三度断って「大浴場に二十人と浸かるより」と書き、「誰にも気兼ねせん我が家の風呂と縁側が、日本一の特等席ばい。」と結んでいます。デイサービスの大浴場は、この方には尊厳を削る場所になります。",null,null,null,null,"script-c95f77854ccd9712-8742","2036-02-10T21:00:00.014276+09:00"],[8674,8108698953664896,1724362114962653,1171315306058308,0,"発言","風呂は命の洗濯と本人が言うとる。止めんでよか。見守る形だけ考えよう。時計と一言の約束なら守る人たい。",null,null,null,null,"script-d4077c0201bd4d74-8743","2036-02-10T21:10:00.011463+09:00"],[8675,7188128189226417,1724362114962653,7457996563753134,0,"発言","三つ目は、和子さんへの思いです。2026年11月15日に「あの日、施設やなくて家に連れて帰ればよかった。」、17日に「和子は家に帰りたがっとった。帰してやれんかった。」。2029年11月17日には、夢の中で和子さんが「うちに帰りたい」と泣いたこと、「五年たっても、帰してやれんかったことは薄まらん。薄まらんでよか。」とあります。2034年11月17日は「和子ば施設に入れて悪かった。俺はこの家から一歩も出らん。」。「この家で野垂れ死んでもよか」という口癖は、わがままではなく、奥様への誓いのように読めます。",null,null,null,null,"script-79303059914cbdcf-8744","2036-02-10T21:30:00.011483+09:00"],[8676,4869348536643140,1724362114962653,3,0,"発言","父が母のことをそんなふうに思っていたとは、わたしにも言いませんでした。ツインへは、父が自分で話す場所だと思って、わたしは読まないようにしてきました。田中さんが読むのは、父を決めつけるためじゃなく、父に近づくため、ですよね。",null,null,null,null,"script-06201ea1a15679c3-8745","2036-02-10T21:45:00.009886+09:00"],[8677,613998318369714,1724362114962653,7457996563753134,0,"発言","はい。お父様の言葉は、お父様のものとして扱います。私の言葉に置き換えません。",null,null,null,null,"script-88370f356fe4386d-8746","2036-02-10T21:55:00.013265+09:00"],[8678,5413221497855597,1724362114962653,7457996563753134,0,"発言","四つ目は、健太くんとの将棋です。2031年1月3日に「六つの子が飛車を持つ手は、指先が盤の上で迷子になる。それでも二つ目の三筋で、飛車を横へ滑らせて、俺の歩を取った。教えたことのない手じゃった。筋がよか。」。2033年1月11日のつぶやきには「健太の三学期の目標は『飛車をうまく使う』。去年の『ころばんように』を、孫は覚えとったらしい。」とあります。2031年6月20日、算数で百点を取った健太くんに鰻を約束し、「百点の孫との約束は、規定より上にある。」と書いています。",null,null,null,null,"script-1e8bc1c7422a8aae-8747","2036-02-10T22:10:00.012510+09:00"],[8679,8512335196681749,1724362114962653,7457996563753134,0,"発言","五つ目は正雄さんです。2029年6月24日の正雄さんのコメントに「負けると黙るくせに、次の日取りだけはきっちり決める人です。」。2033年2月28日のツインへには「友というのは、気づいとるのに茶ば入れる者のことじゃ。」とあります。正雄さんの火曜と土曜は、ケアの一部ではなく、お父様の一番の拠り所だと思います。",null,null,null,null,"script-9b5de3df9cb7fc7f-8748","2036-02-10T22:25:00.011745+09:00"],[8680,8307236818034267,1724362114962653,7457996563753134,0,"発言","ただ、2032年1月3日に「他人が家に入るとは絶対に好かん。」ともあります。私が一番慎重にならなければならない所です。一方で、昨年12月16日のツインへには「先生は他人の数に入っとらんかった。誰が他人で誰がそうでないか、俺は勘定で決めとらん。顔と声で決めとる。」とあります。私は、顔と声で「他人でない人」の側に入れていただける道を探します。",null,null,null,null,"script-4c7db0690383cb7a-8749","2036-02-10T22:40:00.012621+09:00"],[8681,5735808665535340,1724362114962653,1171315306058308,0,"発言","それがよか。鈴木さんは役所の人の礼儀を持っとる。礼儀を尽くす人には、礼儀で返す人たい。",null,null,null,null,"script-a44b0f919dcd48f6-8750","2036-02-10T22:50:00.011276+09:00"],[8682,882042551795313,1724362114962653,3,0,"発言","ありがとうございます。父のことを、こんなに読んでくださった人は初めてです。わたしはずっと、父が頑固なだけだと思っていました。",null,null,null,null,"script-0ba4d13a089d70d1-8751","2036-02-10T23:00:00.010662+09:00"],[8683,8506259947808629,8985664698379372,4,0,"発言","着いたばい。晴れよるな。",null,null,null,null,"script-a0b517757c464141-8752","2036-02-12T12:57:00.010926+09:00"],[8684,1145047567707723,1713317520869645,4,0,"発言",null,null,6922093413063616,8369504108748565,null,"script-37df25eaa3cf312a-8753","2036-02-12T17:25:00.011206+09:00"],[8685,4269150793637494,4887126960195401,1171315306058308,0,"発言","鈴木さん、寄らせてもらいました。152の85でした。今日の湯のみは二つ出とりましたね。",null,null,null,null,"script-6ad487971d231c27-8754","2036-02-14T11:00:00.005172+09:00"],[8686,6673069444516513,4887126960195401,1,0,"発言","二つ。",null,null,null,null,"script-de275c4e41c61308-8755","2036-02-14T11:08:00.005235+09:00"],[8687,409802688732664,7465187753727895,6900329751302857,0,"発言","じいちゃん チョコ とどいた？ ことしは 1つぶだけ。ぎんの かたちの チョコだよ。きょねんは 3つぶ だったけど、ことしは おおきいよ！",null,null,null,null,"script-2be934342b2271ca-8756","2036-02-14T16:50:00.006639+09:00"],[8688,6191687239384825,7465187753727895,1,0,"発言","届いた。食った。",null,null,null,null,"script-e3f76018a3238bc4-8757","2036-02-14T17:20:00.007249+09:00"],[8689,7018359927356008,4035355693922802,1,0,"発言",null,null,215290862932372,5751405043945905,null,"script-7ce9a55085b16c63-8758","2036-02-14T18:00:00.004638+09:00"],[8690,4849842156584012,4035355693922802,null,1,"発言",null,null,6334707349394212,5751405043945905,null,null,"2036-02-14T18:00:00.004638+09:00"],[8691,113201888826613,4035355693922802,null,1,"発言",null,null,4638093940686104,5751405043945905,null,null,"2036-02-14T18:00:02.006818+09:00"],[8692,3439908139864298,4035355693922802,null,1,"発言",null,null,4467993725894483,5751405043945905,null,null,"2036-02-14T18:00:02.006818+09:00"],[8693,4122107272725304,8985664698379372,4,0,"発言","着いたばい。雨ばいな。美穂ちゃんの傘がある。",null,null,null,null,"script-03eb6025f4f7c97f-8761","2036-02-16T12:57:00.005641+09:00"],[8694,4670229493144590,1713317520869645,3,0,"発言",null,null,8893659815220318,8369504108748565,null,"script-998f91e6a60c525d-8762","2036-02-16T16:40:00.030338+09:00"],[8695,6493140609428275,1713317520869645,3,0,"発言",null,null,4490603715775394,8369504108748565,null,"script-c44a01902d0f9449-8763","2036-02-17T11:40:00.004582+09:00"],[8696,4638870687054060,762065606528927,3,0,"発言","バス停に着いたよ。二日間ありがとう。",null,null,null,null,"script-41d370cdca3b6041-8764","2036-02-17T17:30:00.005625+09:00"],[8697,269933980254519,8985664698379372,4,0,"発言","着いたばい。雨水ち言うが、晴れとるな。",null,null,null,null,"script-2e5c8200ed3ec841-8766","2036-02-19T12:56:00.005622+09:00"],[8698,7072870552857306,1713317520869645,4,0,"発言",null,null,3014129106944512,8369504108748565,null,"script-35b9fc3df0445d13-8767","2036-02-19T17:15:00.005183+09:00"],[8699,6836095593844677,8985664698379372,4,0,"発言","着いたばい。天皇誕生日たい。梅は咲いたか。",null,null,null,null,"script-fe63a52184242ba6-8768","2036-02-23T12:56:00.005675+09:00"],[8700,5234920994078072,1713317520869645,4,0,"発言",null,null,680549453803666,8369504108748565,null,"script-6e61b81107c059ec-8769","2036-02-23T17:10:00.006502+09:00"],[8701,1103957119242386,8985664698379372,4,0,"発言","着いたばい。曇っとるな。",null,null,null,null,"script-36707da33b67cfb5-8770","2036-02-26T12:56:00.007348+09:00"],[8702,8879092916211009,1713317520869645,4,0,"発言",null,null,8560059650247807,8369504108748565,null,"script-41c32e8e4b56bcb5-8771","2036-02-26T17:20:00.006793+09:00"],[8703,8054858208286817,7142280074510825,3,0,"発言","正雄さん、お願いがあります。金曜の二十九日は閏日です。四年前の閏日に、父は「四年後の今日、健太は十一歳、俺は八十三。砂時計を盤の横に置いて、一分ひっくり返した」と投稿して、わたしは「その日も盤を挟んで座ってね」とコメントしました。父は覚えていないと思います。金曜でお願いしづらいのですが、お昼だけ寄っていただけませんか。",null,null,null,null,"script-965fbae4ec8bd905-8772","2036-02-26T18:05:00.006674+09:00"],[8704,7116646057031287,7142280074510825,4,0,"発言","よか。金曜の十三時に行く。俺は暇な元運転手ばい。盤は座敷に出したままにしとく。砂時計も盤の横に置く。誠さんには何も言わん。座らせるだけたい。",null,null,null,null,"script-361a601b6fad8985-8773","2036-02-26T18:20:00.007561+09:00"],[8705,3302585520679744,8985664698379372,4,0,"発言","誠さん、金曜も行くばい。二十九日たい。",null,null,null,null,"script-4a4bf021fc8529f6-8774","2036-02-27T12:30:00.006704+09:00"],[8706,6941037082399801,8985664698379372,1,0,"発言","金曜は来る日じゃなか。",null,null,null,null,"script-ba0190885d41bf7a-8775","2036-02-27T12:40:00.006177+09:00"],[8707,3415179640038939,8985664698379372,4,0,"発言","金曜は特別たい。茶ば沸かしとけ。",null,null,null,null,"script-a86dc859a81193ff-8776","2036-02-27T12:48:00.010676+09:00"],[8708,5051853546913410,4887126960195401,1171315306058308,0,"発言","鈴木さん、寄らせてもらいました。156の84でした。あしたは四年に一度の日ですね。",null,null,null,null,"script-22e87a88f7efa1ab-8777","2036-02-28T11:00:00.005858+09:00"],[8709,3431863475928195,4887126960195401,1,0,"発言","四年。",null,null,null,null,"script-9c74e465b663416b-8778","2036-02-28T11:08:00.006047+09:00"],[8710,2551159752242237,6367279538259149,7457996563753134,0,"発言","美穂さん、初回の訪問を、三月十五日の土曜でいかがでしょう。正雄さんがいらっしゃる日の午後一時過ぎに。お父様には、先生が紹介してくれた人が、将棋盤を見に寄る、とだけお伝えください。介護の話はしません。",null,null,null,null,"script-9c1e796dd4c5fb31-8779","2036-02-28T20:00:00.011567+09:00"],[8711,3793960427009624,6367279538259149,3,0,"発言","お願いします。父には、そう伝えます。",null,null,null,null,"script-99d9f3c3fde49a57-8780","2036-02-28T20:20:00.006177+09:00"],[8712,7144039797552841,8985664698379372,4,0,"発言","誠さん、今日は十三時に行くばい。雪まじりやけん、暖かうしとけ。",null,null,null,null,"script-a7e9d3f9d7add7b6-8781","2036-02-29T08:20:00.005489+09:00"],[8713,1701795456930043,8985664698379372,1,0,"発言","来るか。",null,null,null,null,"script-03697961bffa0bef-8782","2036-02-29T08:40:00.005990+09:00"],[8714,3902717262845132,8985664698379372,4,0,"発言","着いたばい。雪まじりたい。ストーブはつけとるな。",null,null,null,null,"script-2b52d7ac4e978d39-8783","2036-02-29T12:50:00.006409+09:00"],[8715,3692437882803082,4035355693922802,1,0,"発言",null,null,3746328704098502,3796211823628380,null,"script-451e3336975dd947-8784","2036-02-29T15:20:00.005600+09:00"],[8716,3570645579754541,4035355693922802,null,1,"発言",null,null,3670427077536969,3796211823628380,null,null,"2036-02-29T15:20:00.005600+09:00"],[8717,6356879653236562,7465187753727895,6900329751302857,0,"発言","じいちゃん きょうは うるうび！ 4ねんまえ ぼく「つぎの うるうびは 11さい」って いったよ。ほんとに 11さいだ！",null,null,null,null,"script-da597a19ca25ab8e-8786","2036-02-29T16:20:00.006311+09:00"],[8718,3581738227105577,7465187753727895,1,0,"発言","十一歳か。大きゅうなった。",null,null,null,null,"script-ddc9e6d8114183d8-8787","2036-02-29T16:40:00.008317+09:00"],[8719,7119287588132126,1713317520869645,4,0,"発言",null,null,6422785427893285,8369504108748565,null,"script-72cb72806c64c2cd-8788","2036-02-29T17:10:00.005120+09:00"],[8720,6205235399337919,1713317520869645,3,0,"発言",null,null,2575081167613731,8369504108748565,null,"script-6794c76f2c15b7c9-8789","2036-02-29T17:30:00.007995+09:00"],[8721,5008752187138996,4035355693922802,1,0,"発言",null,null,5242223529857884,3796211823628380,null,"script-5d43edee87c24c29-8790","2036-02-29T21:30:00.006094+09:00"],[8722,8548321525015448,4035355693922802,null,1,"発言",null,null,1600293553683014,3796211823628380,null,null,"2036-02-29T21:30:00.006094+09:00"],[8723,8902320925771943,4035355693922802,null,1,"発言",null,null,6021204991131414,3796211823628380,null,null,"2036-02-29T21:30:01.005184+09:00"],[8725,7510337415018438,8985664698379372,4,0,"発言","着いたばい。美穂ちゃんもおるな。晴れて、雛の季節ばいな。",null,null,null,null,"script-fb6ec54d2741d9c7-8792","2036-03-01T12:56:00.006050+09:00"],[8726,4155099775530508,1713317520869645,3,0,"発言",null,null,7648172697600701,8369504108748565,null,"script-2335e2e42678f056-8793","2036-03-01T15:30:00.098644+09:00"],[8727,6184384013469667,1713317520869645,4,0,"発言",null,null,8626875114610565,8369504108748565,null,"script-c3d6abd7a35affb1-8794","2036-03-01T15:50:00.004283+09:00"],[8728,8004873256697988,4035355693922802,1,0,"発言",null,null,1106097087105802,3681904256012818,null,"script-debb9a7a9551d8dd-8795","2036-03-02T10:40:00.004933+09:00"],[8729,5827866099193796,4035355693922802,null,1,"発言",null,null,6529817781096738,3681904256012818,null,null,"2036-03-02T10:40:00.004933+09:00"],[8730,5479064534078547,4035355693922802,null,1,"発言",null,null,7847989690623014,3681904256012818,null,null,"2036-03-02T10:40:02.015740+09:00"],[8731,6054306808686907,4035355693922802,null,1,"発言",null,null,3862169878141171,3681904256012818,null,null,"2036-03-02T10:40:02.015740+09:00"],[8732,5995517250233478,762065606528927,3,0,"発言","バス停に着いたよ。二日間ありがとう。あしたは記念日やね。",null,null,null,null,"script-895f51d67b9f4883-8799","2036-03-02T17:30:00.034733+09:00"],[8733,2567144000915389,762065606528927,1,0,"発言","五十七。",null,null,null,null,"script-8301617f65b474d4-8800","2036-03-02T17:50:00.050198+09:00"],[8734,8245747222366991,4035355693922802,1,0,"発言",null,null,345674438045404,3728027550835001,null,"script-e4a711a2d2d19268-8801","2036-03-03T18:20:00.047394+09:00"],[8735,1966764694613726,4035355693922802,null,1,"発言",null,null,2494735922658986,3728027550835001,null,null,"2036-03-03T18:20:00.047394+09:00"],[8736,3132511087557012,4035355693922802,1,0,"発言",null,null,4694866541119512,3728027550835001,null,"script-af859ed37991770c-8804","2036-03-03T21:30:00.093327+09:00"],[8737,1077281577856607,4035355693922802,null,1,"発言",null,null,757764772271574,3728027550835001,null,null,"2036-03-03T21:30:00.093327+09:00"],[8738,3039203063182536,4035355693922802,null,1,"発言",null,null,3726753464898700,3728027550835001,null,null,"2036-03-03T21:30:01.010750+09:00"],[8739,7724490323208332,4035355693922802,null,1,"発言",null,null,4192267102118096,3728027550835001,null,null,"2036-03-03T21:30:01.010750+09:00"],[8740,6343812355244258,8985664698379372,4,0,"発言","着いたばい。昨日は記念日やったげな。",null,null,null,null,"script-fd14aabcb5147b01-8806","2036-03-04T12:57:00.006240+09:00"],[8741,8393529518385552,1713317520869645,4,0,"発言",null,null,4306971266820545,8369504108748565,null,"script-b43172a7910d8487-8807","2036-03-04T17:20:00.013035+09:00"],[8742,5910637669684211,8985664698379372,4,0,"発言","着いたばい。晴れよるな。縁側が楽たい。",null,null,null,null,"script-3f6c93186b4948ca-8808","2036-03-08T12:56:00.006470+09:00"],[8743,7003569705704083,1713317520869645,4,0,"発言",null,null,2225119982329892,8369504108748565,null,"script-44358fe84d777d7d-8809","2036-03-08T17:20:00.007473+09:00"],[8744,6913482144095071,2615179707560968,1,0,"発言","節子さん、新聞は。",null,null,null,null,"script-621cc56acfc24d69-8810","2036-03-10T07:10:00.005318+09:00"],[8745,6241096450347465,8985664698379372,4,0,"発言","着いたばい。くもりたいな。",null,null,null,null,"script-866601f30a2b55f3-8811","2036-03-11T12:58:00.006582+09:00"],[8746,8905705471565780,1713317520869645,4,0,"発言",null,null,2649961739460198,8369504108748565,null,"script-407ed5aaa0b4411d-8812","2036-03-11T17:15:00.008802+09:00"],[8747,2745865929559250,4887126960195401,1171315306058308,0,"発言","鈴木さん、寄らせてもらいました。151の86でした。土曜に田中君が盤を見に来るち聞いとります。",null,null,null,null,"script-e0bd03f0a04a3a48-8813","2036-03-13T11:00:00.005207+09:00"],[8748,6927312133823733,4887126960195401,1,0,"発言","盤を見に。",null,null,null,null,"script-7362b9cf3c36a2ea-8814","2036-03-13T11:09:00.010856+09:00"],[8749,678384277589156,762065606528927,3,0,"発言","お父さん、今日は休みを取ったけん、昼の電車で行くね。あしたは田中さんが来る日やね。",null,null,null,null,"script-bd68812e9c450e6d-8815","2036-03-14T09:30:00.007760+09:00"],[8750,2926300547236752,762065606528927,1,0,"発言","盤を見に来る人。",null,null,null,null,"script-70ab977de157cc11-8816","2036-03-14T09:40:00.009009+09:00"],[8751,6798856904137480,5084375815500449,7457996563753134,0,"発言","正雄さん、田中です。一時半ごろ、玄関の外に着きます。",null,null,null,null,"script-fe119ba95736affd-8817","2036-03-15T12:40:00.007665+09:00"],[8752,2513992597067009,5084375815500449,4,0,"発言","よか。俺が先に誠さんに「将棋の好きな人が来た」と言う。入るのはその後たい。",null,null,null,null,"script-2dec79db4931bee0-8818","2036-03-15T12:46:00.008273+09:00"],[8753,3953972903906309,8985664698379372,4,0,"発言","着いたばい。美穂ちゃんもおるな。今日は客が来る日たい。湯のみば四つ出しとけ。",null,null,null,null,"script-36a01ae60e881742-8819","2036-03-15T12:56:00.006186+09:00"],[8754,3283693501909886,5084375815500449,4,0,"発言","今、言うた。入れ。",null,null,null,null,"script-a4aae49800072e78-8820","2036-03-15T13:25:00.006453+09:00"],[8755,8492960506180972,1713317520869645,4,0,"発言",null,2305820748068070,5506223609569710,8369504108748565,null,"script-367d30c012021153-8822","2036-03-15T15:25:00.035978+09:00"],[8756,3449970476057000,1713317520869645,7457996563753134,0,"発言",null,null,1951662334452212,8369504108748565,null,"script-74f66b7b72a4c56d-8823","2036-03-15T15:40:00.005433+09:00"],[8757,1104608165115436,6367279538259149,3,0,"発言","田中さん、ありがとうございました。父が自分で湯のみを出したのを見て、驚きました。田中さんがチームで書いてくださった「顔と声で決めとる」の意味が、少し分かった気がします。",null,null,null,null,"script-20429ed6b3219a20-8824","2036-03-15T16:30:00.004939+09:00"],[8758,1036704308290863,6367279538259149,7457996563753134,0,"発言","美穂さん、今日はお父様が決めてくださった日です。私は何も押しつけていません。次は四月に、プランの形を持って伺います。それまでに、お父様が「よか」と言える形かどうか、もう一度考えます。",null,null,null,null,"script-3f64ab7d6e3aafc6-8825","2036-03-15T16:50:00.008129+09:00"],[8759,4679113326736225,4035355693922802,1,0,"発言",null,null,1206428033746806,5104165610733193,null,"script-e7ed0d37d5b563ec-8826","2036-03-15T21:10:00.006321+09:00"],[8760,6313680548906343,4035355693922802,null,1,"発言",null,null,5581479138106462,5104165610733193,null,null,"2036-03-15T21:10:00.006321+09:00"],[8761,89112515853926,4035355693922802,null,1,"発言",null,null,6115995572269859,5104165610733193,null,null,"2036-03-15T21:10:01.022506+09:00"],[8763,7943294757657471,762065606528927,3,0,"発言","バス停に着いたよ。二日間ありがとう。冷蔵庫の紙、見てね。",null,null,null,null,"script-e07c7248848dd50c-8828","2036-03-16T17:30:00.004026+09:00"],[8764,2902358958083860,762065606528927,1,0,"発言","たなか。",null,null,null,null,"script-742ed90ab7f8d56c-8829","2036-03-16T17:50:00.014322+09:00"],[8765,8006276816669941,8985664698379372,4,0,"発言","着いたばい。春の彼岸の入りたい。",null,null,null,null,"script-3b055e595550dc13-8831","2036-03-18T12:57:00.012960+09:00"],[8766,1157270556482106,1713317520869645,4,0,"発言",null,null,8211840838114688,8369504108748565,null,"script-810e4da77bab4f4a-8832","2036-03-18T17:20:00.012708+09:00"],[8767,4539615682885125,1724362114962653,3,0,"発言","施設から連絡がありました。四月の第一週に一部屋空くそうです。返事の期限は三月の末までと言われました。",null,null,null,null,"script-657da4f87ec2841b-8833","2036-03-19T12:10:00.005691+09:00"],[8768,7319209410505715,1724362114962653,7457996563753134,0,"発言","お知らせありがとうございます。まず期限が分かってよかったです。私から三つあります。一つ、見送っても順番の記録を残せるか、施設に確認すること。二つ、お父様の前で「知っておく」を壊さないこと。三つ、美穂さんがどちらを選んでも、私は責めません。",null,null,null,null,"script-996e6eacd397de12-8834","2036-03-19T12:40:00.015280+09:00"],[8769,3428914391705093,1724362114962653,1171315306058308,0,"発言","順番が残るかどうかが一番大事たい。残るなら、今回は見送って、田中君のプランが回るのを見てから考えても遅くない。",null,null,null,null,"script-4a8f95fbc368537f-8835","2036-03-19T13:00:00.012564+09:00"],[8770,8773878418146112,4035355693922802,1,0,"発言",null,null,3932071803193566,1161195670641708,null,"script-ef36701b0f50a84e-8836","2036-03-19T18:20:00.012306+09:00"],[8771,7126262053882036,4035355693922802,null,1,"発言",null,null,2514302912798827,1161195670641708,null,null,"2036-03-19T18:20:00.012306+09:00"],[8772,2091314585033247,4035355693922802,null,1,"発言",null,null,5820979865926159,1161195670641708,null,null,"2036-03-19T18:20:02.004613+09:00"],[8773,2531767719041775,4035355693922802,null,1,"発言",null,null,2637578867838970,1161195670641708,null,null,"2036-03-19T18:20:02.004613+09:00"],[8774,5031228107356824,8985664698379372,4,0,"発言","着いたばい。雨上がりたいな。",null,null,null,null,"script-58daaac76fe6cfb6-8840","2036-03-22T12:57:00.011676+09:00"],[8775,1610733072838281,1713317520869645,4,0,"発言",null,null,8974926753595435,8369504108748565,null,"script-dede238e584c1199-8841","2036-03-22T17:15:00.007825+09:00"],[8776,6554459932090781,8985664698379372,4,0,"発言","着いたばい。雨が上がったな。",null,null,null,null,"script-6087e56ea6fd9ab3-8842","2036-03-25T12:58:00.008565+09:00"],[8777,2571941740776707,1713317520869645,4,0,"発言",null,null,5589090931201963,8369504108748565,null,"script-6d2d29ba7457941b-8843","2036-03-25T17:25:00.009963+09:00"],[8778,8546236938011830,1724362114962653,3,0,"発言","施設に確認しました。見送っても、待機の順番は残るそうです。今回は見送ります。",null,null,null,null,"script-69e11b0aabf14a30-8844","2036-03-25T21:15:00.006484+09:00"],[8779,7002630086403546,1724362114962653,7457996563753134,0,"発言","承知しました。選択肢を手放さない見送りですね。美穂さんが決めたことを、私も尊重します。",null,null,null,null,"script-70002f694a87b770-8845","2036-03-25T21:30:00.010444+09:00"],[8780,7916986832947210,1724362114962653,1171315306058308,0,"発言","それでよか。",null,null,null,null,"script-abbee914bdbfa3d8-8846","2036-03-25T21:40:00.007685+09:00"],[8781,3155938159878990,4887126960195401,1171315306058308,0,"発言","鈴木さん、寄らせてもらいました。155の82です。湯のみは二つ。",null,null,null,null,"script-c2ea852d69823c68-8847","2036-03-27T11:00:00.010341+09:00"],[8782,3015808433946928,4887126960195401,1,0,"発言","二つ。",null,null,null,null,"script-ac20feb398dfe499-8848","2036-03-27T11:07:00.013066+09:00"],[8783,541413812552610,8985664698379372,4,0,"発言","着いたばい。今日はホークスの日たい。",null,null,null,null,"script-96c48225fa6f3398-8849","2036-03-29T12:57:00.014147+09:00"],[8784,259861581311591,8985664698379372,4,0,"発言","ホークスは勝ったばい。巨人は負けた。昨日は二つとも勝ったが、今日は分かれた。誠さん、今日は憎まれ口が言えんな。",null,null,null,null,"script-9f925fbd735673b8-8850","2036-03-29T17:10:00.009498+09:00"],[8785,2483463195185960,8985664698379372,1,0,"発言","お前は黙れ。",null,null,null,null,"script-e186a0075b981020-8851","2036-03-29T17:16:00.009050+09:00"],[8786,1398208549327314,8985664698379372,4,0,"発言","着いたばい。四月ばい。縁側が暖かか。",null,null,null,null,"script-9fa22437c2d3a217-8852","2036-04-01T12:57:00.009345+09:00"],[8787,3872670446062068,1713317520869645,4,0,"発言",null,null,2576473965787472,8369504108748565,null,"script-41d674f35760aaac-8853","2036-04-01T17:20:00.009320+09:00"],[8788,6252888431153432,1214349764252102,7457996563753134,0,"発言","誠一さん、田中です。今日は、お茶を一杯いただきに寄りました。お話は長くしません。",null,null,null,null,"script-465a21bf81e41b4b-8855","2036-04-02T14:10:01.011490+09:00"],[8789,4205328461434844,1214349764252102,1,0,"発言","上がれ。",null,null,null,null,"script-ea40d5720e62be60-8856","2036-04-02T14:20:00.013920+09:00"],[8790,2113740420257144,1713317520869645,7457996563753134,0,"発言",null,null,2127206706916748,8369504108748565,null,"script-58e73d8445bae8e2-8857","2036-04-02T15:50:00.011669+09:00"],[8791,4838479903806802,1713317520869645,3,0,"発言",null,null,5295363336319561,8369504108748565,null,"script-cfba11180b5d8cb9-8858","2036-04-02T16:10:00.011671+09:00"],[8792,6249642878102162,1713317520869645,4,0,"発言",null,null,8102812787782210,8369504108748565,null,"script-34538af5b0326c40-8859","2036-04-02T16:30:00.008944+09:00"],[8793,140871470654122,2615179707560968,1,0,"発言","節子さん、ゴミは。",null,null,null,null,"script-08d8c19a18b8dc35-8860","2036-04-03T07:00:00.007368+09:00"],[8794,1933965768992099,4035355693922802,1,0,"発言",null,null,8664084762690124,1339001218270231,null,"script-a13c1e993aa9dfab-8861","2036-04-04T20:30:00.010132+09:00"],[8795,1917342418018749,4035355693922802,null,1,"発言",null,null,8305453672770754,1339001218270231,null,null,"2036-04-04T20:30:00.010132+09:00"],[8796,4904751402576752,4035355693922802,null,1,"発言",null,null,8328383549600572,1339001218270231,null,null,"2036-04-04T20:30:02.010674+09:00"],[8797,2230865799334553,4035355693922802,null,1,"発言",null,null,2369350026798787,1339001218270231,null,null,"2036-04-04T20:30:02.010674+09:00"],[8798,3558031412268865,8985664698379372,4,0,"発言","着いたばい。美穂ちゃんもおるな。桜餅ば買うてきた。",null,null,null,null,"script-796c4d49105de29c-8864","2036-04-05T12:57:00.017795+09:00"],[8799,6697097689678012,1713317520869645,3,0,"発言",null,null,1131616877645123,8369504108748565,null,"script-93013213a910e1fa-8865","2036-04-05T16:50:00.014699+09:00"],[8800,3955916669057278,8985664698379372,4,0,"発言","桜餅は勝ったばい。ホークスも巨人も負けたけん、今日は餅だけが勝ちたい。",null,null,null,null,"script-cbca68c4c03c21ad-8866","2036-04-05T17:15:00.006972+09:00"],[8801,662089924179246,8985664698379372,1,0,"発言","餅に感謝。",null,null,null,null,"script-46c1d31afa8e80ec-8867","2036-04-05T17:20:00.011364+09:00"],[8802,2250756507180595,1713317520869645,3,0,"発言",null,null,5258322044275538,8369504108748565,null,"script-83e2c54395860514-8868","2036-04-06T11:20:00.012295+09:00"],[8803,2271162759219048,762065606528927,3,0,"発言","バス停に着いたよ。二日間ありがとう。",null,null,null,null,"script-50740c244acf0fbe-8869","2036-04-06T17:30:00.010731+09:00"],[8804,2085494239061272,762065606528927,1,0,"発言","霧は晴れる。",null,null,null,null,"script-6262d3cb65dac4c9-8870","2036-04-06T17:50:00.010291+09:00"],[8805,7753197774611714,4887126960195401,1171315306058308,0,"発言","鈴木さん、寄らせてもらいました。157の86でした。雨ですが、お茶はぬるめでよかですよ。",null,null,null,null,"script-40cb057ee984fc4a-8872","2036-04-10T11:00:00.012156+09:00"],[8806,5344088407139504,4887126960195401,1,0,"発言","ぬるめ。",null,null,null,null,"script-6c7055eeeb3deae8-8873","2036-04-10T11:08:00.010639+09:00"],[8807,389874771141100,8985664698379372,4,0,"発言","着いたばい。晴れて縁側がよか。",null,null,null,null,"script-088016f0978382bd-8874","2036-04-12T12:56:00.011356+09:00"],[8808,6920781313075252,1713317520869645,4,0,"発言",null,null,7238396114153754,8369504108748565,null,"script-29be41e4263cdc59-8875","2036-04-12T17:10:00.009227+09:00"],[8809,6262116055092259,8985664698379372,4,0,"発言","今日は巨人もホークスも負けたばい。誠さん、湯は上げるな、下げるな。",null,null,null,null,"script-0f833ba625febdcd-8876","2036-04-12T17:20:00.013090+09:00"],[8810,8143430815652453,8985664698379372,1,0,"発言","上げも下げもせん。",null,null,null,null,"script-7c9910c69c7e1f32-8877","2036-04-12T17:26:00.008712+09:00"],[8811,6838355050593294,2615179707560968,1,0,"発言","節子さん、回覧板は。",null,null,null,null,"script-68dc8180bbd5d77d-8878","2036-04-14T07:00:00.008666+09:00"],[8812,3666177292187694,8985664698379372,4,0,"発言","着いたばい。年金の日たい。",null,null,null,null,"script-f1bec3427b87ba59-8879","2036-04-15T12:56:00.009597+09:00"],[8813,3177846838227314,8985664698379372,4,0,"発言","着いたばい。健太も夫さんもおるな。今日は田中さんも来るとか。",null,null,null,null,"script-7a0cc9ceff86702f-8880","2036-04-19T12:56:00.009635+09:00"],[8814,4243590168591541,1214349764252102,7457996563753134,0,"発言","誠一さん、田中です。今日は、夕方のご飯の話だけさせてください。",null,null,null,null,"script-847eb5e46b04284e-8881","2036-04-19T13:35:00.008647+09:00"],[8815,246597031050413,4035355693922802,1,0,"発言",null,null,8828707283767502,6237651145456945,null,"script-e930abba85e607d9-8882","2036-04-19T15:40:00.010675+09:00"],[8816,8876544340112659,4035355693922802,null,1,"発言",null,null,4572516721228840,6237651145456945,null,null,"2036-04-19T15:40:00.010675+09:00"],[8817,6029623135166479,1713317520869645,7457996563753134,0,"発言",null,null,8460759699860671,8369504108748565,null,"script-84fe5a39f4c1bf66-8884","2036-04-19T15:55:00.013889+09:00"],[8818,2273283657299175,1724362114962653,7457996563753134,0,"発言","ケアプランの案です。お父様の言葉に合わせて三つにしました。一つ目、夕方四時半ごろ、毎回同じヘルパーが伺い、米を研ぐところから一緒に炊きます。炊き上がりの蓋はお父様が開けます。台所と土鍋の主役は、お父様のままです。夕方五時の玄関の落ち着かなさにも、そこで人が入ります。",null,null,null,null,"script-a9fe0cd597a2d0a4-8886","2036-04-19T17:30:00.012565+09:00"],[8819,2314517103833639,1724362114962653,7457996563753134,0,"発言","二つ目、お風呂は今まで通り一人で入っていただきます。ヘルパーは浴室に入らず、台所で待ちます。「入る」「上がった」の声と、赤いシールの時計で見守ります。三つ目、集団のデイサービスと配食弁当は使いません。理由は二月にお話ししたとおり、記録にお父様の言葉があるからです。",null,null,null,null,"script-8176c1361480ccdf-8887","2036-04-19T17:36:00.012440+09:00"],[8820,5150376652951317,1724362114962653,3,0,"発言","お風呂のことまで、記録を見て決めてくださったんですね。父は他人が入るのを嫌がると思いますが、「炊きたてなら、よか」と本人が言ったので、試してみたいです。",null,null,null,null,"script-a32ef22b1511b0b0-8888","2036-04-19T17:50:00.026733+09:00"],[8821,1728674760406386,1724362114962653,1171315306058308,0,"発言","田中君、よかプランたい。ヘルパーは同じ人にしてやってくれ。顔を覚えるまでが勝負ばい。",null,null,null,null,"script-71635c41bf4bc55f-8889","2036-04-19T18:05:00.018666+09:00"],[8822,607956151502914,1724362114962653,7457996563753134,0,"発言","はい。同じ人が伺います。お父様が「よか」と言えるまで、ヘルパーが台所に入るのは、お父様が許した所までにします。五月の連休に、お父様と美穂さんと私で、もう一度ゆっくり話す場を持たせてください。",null,null,null,null,"script-7196bb916ca4c3cc-8890","2036-04-19T18:15:00.015031+09:00"],[8823,8970911258023121,4251523932161740,7457996563753134,0,"発言","節子さま、ケアプランの形ができました。朝夕のヘルパーの巡回と見守りの仕組みで、鈴木さんが節子さまのところへ行かなくて済む形を考えています。五月の中ごろ、地域包括の者と一緒に、ご説明に伺ってもよろしいでしょうか。",null,null,null,null,"script-7e65b8e22fe78a32-8891","2036-04-19T18:40:00.018245+09:00"],[8824,6237426092358933,4251523932161740,5,0,"発言","お願いいたします お待ちしております 町内会の方にも話していただけるとありがたいです",null,null,null,null,"script-44122d3787771e78-8892","2036-04-19T19:10:00.016782+09:00"],[8825,1799829829613912,4035355693922802,1,0,"発言",null,null,1232069871000612,6237651145456945,null,"script-8291abc7295c4576-8893","2036-04-19T22:00:00.016059+09:00"],[8826,2816232592930456,4035355693922802,null,1,"発言",null,null,9005179594891595,6237651145456945,null,null,"2036-04-19T22:00:00.016059+09:00"],[8827,3585278423727945,4035355693922802,null,1,"発言",null,null,4906958472807938,6237651145456945,null,null,"2036-04-19T22:00:01.008042+09:00"],[8829,1668906461536448,1713317520869645,3,0,"発言",null,1604159944013665,3594478327956416,8369504108748565,null,"script-a1575c19d7bc1100-8895","2036-04-20T09:10:00.052516+09:00"],[8830,967289492835947,1713317520869645,3,0,"発言",null,null,3285240969079844,8369504108748565,null,"script-78bbb26eac1081ad-8896","2036-04-20T10:30:00.008522+09:00"],[8831,5956032685585458,762065606528927,3,0,"発言","バス停に着いたよ。二日間ありがとう。健太と夫も着いたって。",null,null,null,null,"script-a8016327f68ee37f-8898","2036-04-20T17:30:00.008292+09:00"],[8832,6722626448091131,7465187753727895,6900329751302857,0,"発言","じいちゃん きんを ありがとう！ ひきだしに ふ きょうしゃ けいま ぎん きん と ならべたよ。5まい そろった！ つぎは かく かな？ ひしゃ かな？",null,null,null,null,"script-539842b0b3777d0b-8899","2036-04-20T20:00:00.008078+09:00"],[8833,7852783904978245,7465187753727895,1,0,"発言","来年を待て。",null,null,null,null,"script-02b8a6d90bed7003-8900","2036-04-20T20:20:00.008636+09:00"],[8834,830925292231774,4035355693922802,1,0,"発言",null,null,4564891187047998,8618838714349581,null,"script-55d89e61e7c41d3c-8901","2036-04-20T21:10:00.006913+09:00"],[8835,3374232382857377,4035355693922802,null,1,"発言",null,null,524997533749634,8618838714349581,null,null,"2036-04-20T21:10:00.006913+09:00"],[8836,8334191459554928,4035355693922802,null,1,"発言",null,null,4170002149881235,8618838714349581,null,null,"2036-04-20T21:10:01.007329+09:00"],[8838,464826332071451,4035355693922802,1,0,"発言",null,null,7677232450108509,4588823594289045,null,"script-0e70a10a28380c93-8903","2036-04-21T17:20:00.017155+09:00"],[8839,3764346600139519,4035355693922802,null,1,"発言",null,null,5598667824747529,4588823594289045,null,null,"2036-04-21T17:20:00.017155+09:00"],[8840,293606178326838,4035355693922802,null,1,"発言",null,null,6866784456493459,4588823594289045,null,null,"2036-04-21T17:20:02.017923+09:00"],[8841,5532700355403439,4035355693922802,null,1,"発言",null,null,6926123459723870,4588823594289045,null,null,"2036-04-21T17:20:02.017923+09:00"],[8842,2055181511921818,8985664698379372,4,0,"発言","着いたばい。雨ばいな。",null,null,null,null,"script-a66b0f50026338ad-8907","2036-04-22T12:56:00.012093+09:00"],[8843,1281039996493954,4887126960195401,1171315306058308,0,"発言","鈴木さん、寄らせてもらいました。150の85でした。つつじがよう咲いとりますね。",null,null,null,null,"script-3f494eae1f2badaa-8908","2036-04-24T11:00:00.022781+09:00"],[8844,2493152584395376,4887126960195401,1,0,"発言","紅白。",null,null,null,null,"script-63c7766bd70375c7-8909","2036-04-24T11:08:00.027772+09:00"],[8845,3205860827378615,8985664698379372,4,0,"発言","着いたばい。雨たいな。",null,null,null,null,"script-3278d1b96b47cd06-8910","2036-04-26T12:57:00.028439+09:00"],[8846,1736712218773017,8985664698379372,4,0,"発言","今日は二つとも負けたばい。雨とは関係なかな。",null,null,null,null,"script-55a366b3fdd24b4b-8911","2036-04-26T17:20:00.020111+09:00"],[8847,6897075590701943,8985664698379372,4,0,"発言","着いたばい。昭和の日たい。五年前も縁側で、飛車ば横に滑らされたばい。",null,null,null,null,"script-5aa64524aac29d03-8912","2036-04-29T12:57:00.032552+09:00"],[8848,4387196333476582,4035355693922802,1,0,"発言",null,null,1837650788886069,7648453993334935,null,"script-29e2fc211c779284-8913","2036-05-02T18:40:00.016726+09:00"],[8849,88156296122391,4035355693922802,null,1,"発言",null,null,4276234073014524,7648453993334935,null,null,"2036-05-02T18:40:00.016726+09:00"],[8850,377817834777875,1713317520869645,7457996563753134,0,"発言",null,null,7453316481615272,8369504108748565,null,"script-f2b839f3270eda15-8915","2036-05-02T18:55:00.031444+09:00"],[8851,7464437122938426,4035355693922802,1,0,"発言",null,null,8975744153755669,7648453993334935,null,"script-088f1d2e41d85bdd-8917","2036-05-02T23:10:00.009386+09:00"],[8852,4880690685933299,4035355693922802,null,1,"発言",null,null,5837270964570786,7648453993334935,null,null,"2036-05-02T23:10:00.009386+09:00"],[8853,4229940007058423,4035355693922802,null,1,"発言",null,null,8999749267272728,7648453993334935,null,null,"2036-05-02T23:10:01.012205+09:00"],[8855,1353528421256679,8985664698379372,4,0,"発言","着いたばい。連休たいな。美穂ちゃんもおるな。",null,null,null,null,"script-58f30a2555c89970-8920","2036-05-03T12:57:00.006650+09:00"],[8856,5404009957626991,1713317520869645,4,0,"発言",null,null,5376716252320070,8369504108748565,null,"script-46818c237f325398-8921","2036-05-03T17:10:00.005717+09:00"],[8857,800056094730060,1713317520869645,3,0,"発言",null,null,571217447349647,8369504108748565,null,"script-ae8c2887aa412bfe-8922","2036-05-04T11:30:00.025317+09:00"],[8858,2791354394616737,7465187753727895,6900329751302857,0,"発言","じいちゃん こどもの日 あしたは かしわもち たべる？",null,null,null,null,"script-105f04f38eda705c-8923","2036-05-04T17:40:00.042621+09:00"],[8859,1141182786850573,7465187753727895,1,0,"発言","柏餅。食う。",null,null,null,null,"script-296429373a632a1c-8924","2036-05-05T09:20:00.049023+09:00"],[8860,4378373805885693,762065606528927,3,0,"発言","お父さん、お昼に柏餅買ってきたよ。葉は外す？",null,null,null,null,"script-9cb7a7ac99410ac6-8925","2036-05-05T12:30:00.077961+09:00"],[8861,2032798047010316,762065606528927,1,0,"発言","和子は外す人。俺は葉ごと。",null,null,null,null,"script-6da215eedee5df16-8926","2036-05-05T12:36:00.158053+09:00"]]}