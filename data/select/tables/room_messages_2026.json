802,1,0,"発言","場所は言わん。見りゃ分かるたい。",null,null,387646800924149,null,"script-567e1e1dbc387d04-30","2026-10-08T08:10:01.002359+09:00"],[27,6001880227435365,4035355693922802,null,1,"発言",null,null,4604773983360282,387646800924149,null,null,"2026-10-08T08:10:01.018262+09:00"],[28,872036352084044,4035355693922802,null,1,"発言",null,null,4731963717852573,387646800924149,null,null,"2026-10-08T08:10:03.006880+09:00"],[29,5606589767562089,4035355693922802,null,1,"発言",null,null,415825129313682,387646800924149,null,null,"2026-10-08T08:10:03.006880+09:00"],[30,8331206293029944,762065606528927,3,0,"発言","来月の三回忌のことやけど、15日の日曜でお寺にお願いしてもらってもよか？ 私は14日の土曜から帰るけん。",null,null,null,null,"script-ad4e97cab144f0b3-35","2026-10-08T20:12:00.008477+09:00"],[31,3742497023693838,762065606528927,1,0,"発言","寺には俺から言うとく。時間が決まったら知らせる。",null,null,null,null,"script-ae5aa1bd89dbc853-36","2026-10-08T20:30:00.006566+09:00"],[32,1564318894665312,762065606528927,3,0,"発言","ありがとう。健太とうちの人も一緒に行くけんね。",null,null,null,null,"script-65b5ca80a5f49c58-37","2026-10-08T20:33:00.009039+09:00"],[33,7453999448251376,4035355693922802,1,0,"発言",null,null,6700615310897361,4860307733081263,null,"script-a40ffa84750e06de-38","2026-10-09T19:05:00.007780+09:00"],[34,17670385113448,4035355693922802,null,1,"発言",null,null,1411086988251423,4860307733081263,null,null,"2026-10-09T19:05:00.007780+09:00"],[35,235953912774641,4035355693922802,null,1,"発言",null,null,5939867076645587,4860307733081263,7,null,"2026-10-09T19:05:00.007780+09:00"],[36,1863946082717843,4035355693922802,1,0,"発言","さあ、そん時次第たい。",null,null,4860307733081263,null,"script-014f1ea979a9b598-39","2026-10-09T19:05:01.001514+09:00"],[37,5242547791888743,4035355693922802,1,0,"発言",null,null,5167463661416688,4860307733081263,null,"script-9c7793c2388926c3-44","2026-10-09T21:50:00.010803+09:00"],[38,110767868335305,4035355693922802,null,1,"発言",null,null,3701517092699264,4860307733081263,null,null,"2026-10-09T21:50:00.010803+09:00"],[39,445626816537823,4035355693922802,null,1,"発言",null,null,5269