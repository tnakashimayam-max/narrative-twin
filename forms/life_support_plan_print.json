{
  "id": "life_support_plan_print",
  "title": "ライフサポートプラン",
  "use": "ライフサポートプランを出力するときの紙の形。from は、入力の書式（life_support_plan.json）のどの欄を入れるか。",
  "paper": {"size": "A4", "orientation": "横"},
  "header": [
    {"name": "作成日", "from": "作成日"},
    {"name": "確認欄"},
    {"name": "利用者名", "from": "利用者名"},
    {"name": "生年月日", "from": "生年月日"},
    {"name": "住所", "from": "住所"},
    {"name": "事業所名・計画作成担当者名", "from": ["事業所名", "担当者"]},
    {"name": "認定日", "from": "認定日"},
    {"name": "認定の有効期間", "from": ["有効期間開始", "有効期間終了"]},
    {"name": "要介護状態区分", "from": "要介護区分"}
  ],
  "blocks": [
    {"name": "個々の目標（ゴール）", "from": "個々の目標"},
    {"name": "審査会の意見", "from": "審査会の意見"},
    {"name": "当面の目標・ニーズ", "from": "当面の目標／当面の目標", "rows": 2},
    {
      "name": "目標を達成するための具体的プロセス／課題",
      "from": "当面の目標／目標プロセス",
      "columns": [
        {"name": "本人", "from": "当面の目標／本人"},
        {"name": "家族・介護者", "from": "当面の目標／家族"},
        {"name": "地域", "from": "当面の目標／地域"},
        {"name": "事業所", "from": "当面の目標／事業所"},
        {"name": "具体化", "from": ["当面の目標／いつから", "当面の目標／いつまで", "当面の目標／誰が", "当面の目標／どのように", "当面の目標／支援のタイミング等"]}
      ]
    },
    {"name": "他の介護保険サービスの必要と具体的課題", "from": ["サービス内容・目的", "いつから", "いつまで", "誰が", "どのように"]},
    {"name": "モニタリング", "from": "モニタリング内容", "with": [{"name": "評価日", "from": "モニタリング実施日"}]}
  ]
}
